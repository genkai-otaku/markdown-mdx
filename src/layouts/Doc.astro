---
import '../styles/global.css'

const links = [
  { href: '/', label: 'マークダウン' },
  { href: '/mdx', label: 'MDX' },
  { href: '/mdx/syntax', label: 'MDX の記法' },
  { href: '/mdx/components', label: 'コンポーネント' },
] as const

type Props = {
  frontmatter: {
    title: string
    description?: string
  }
}

const { frontmatter } = Astro.props
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isHome = path === '/'
const documentTitle = isHome
  ? frontmatter.title
  : `${frontmatter.title} · マークダウンの書き方`

const lead =
  frontmatter.description ??
  'よく使う記法を、書き方とプレビューで短くまとめた静的なドキュメントです。'
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={lead} />
    <title>{documentTitle}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <p class="site-mark">markdown</p>
        <p class="site-title">マークダウンの書き方</p>
        <p class="site-lead">{lead}</p>
        <nav class="site-nav" aria-label="ページ">
          {
            links.map((link) => {
              const current = path === link.href
              return (
                <a
                  href={link.href}
                  class={current ? 'is-current' : undefined}
                  aria-current={current ? 'page' : undefined}
                >
                  {link.label}
                </a>
              )
            })
          }
        </nav>
      </header>
      <main class="site-main">
        <article class="prose">
          <slot />
        </article>
      </main>
    </div>
  </body>
</html>
